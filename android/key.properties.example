# Copy this file to `key.properties` (same directory) and fill in your own
# real values to sign release builds with a real key instead of the debug
# keys. `key.properties` is git-ignored (see android/.gitignore) — never
# remove it from .gitignore, and never commit a real keystore file either.
#
# See docs/release.md's "Signing setup" section for how to generate the
# keystore this file points at.

storePassword=REPLACE_WITH_YOUR_KEYSTORE_PASSWORD
keyPassword=REPLACE_WITH_YOUR_KEY_PASSWORD
keyAlias=REPLACE_WITH_YOUR_KEY_ALIAS
storeFile=REPLACE_WITH_ABSOLUTE_OR_RELATIVE_PATH_TO_YOUR_KEYSTORE_FILE
